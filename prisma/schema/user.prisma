model User {
  id              String     @id @default(uuid())
  firstName       String
  lastName        String
  email           String     @unique
  password        String
  avatar          String?
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isActive        Boolean    @default(true)
  title           String?
  roles           UserRole[]

  @@map("users")
}
